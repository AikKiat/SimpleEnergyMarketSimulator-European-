# Copy to .env.prod on the EC2 box:  cp .env.prod.example .env.prod
# docker compose reads it via --env-file .env.prod
#
# There is no secret in here. The AI analyst is switched off, so there is no
# Anthropic key to store, and the carbon-intensity feed needs no key either.
# If you re-enable the analyst later, do NOT put the key in this file — pull it
# from SSM Parameter Store or Secrets Manager at container start.

# Browser origins allowed to call /api/**. Comma-separated, no spaces, no
# trailing slash. Must be the exact scheme+host the browser sends.
# Add your custom Vercel domain too if you set one up.
VERCEL_ORIGIN=https://simple-energy-market-simulator-euro.vercel.app
