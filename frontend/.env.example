# Base URL of the Spring backend.
#
# LOCAL DEV: leave this unset. The Vite proxy (see vite.config.ts) forwards
# /api to http://localhost:8080, so everything is same-origin and no CORS
# headers are involved.
#
# PRODUCTION (Vercel): set this to the backend's public HTTPS URL, e.g.
#   VITE_API_BASE=https://api.your-domain.com
#
# Two things must both be true or the browser will block the request:
#   1. the URL is HTTPS — a page served over HTTPS cannot call HTTP
#   2. the Vercel origin is listed in the backend's app.cors.allowed-origins
#
# Note VITE_* variables are baked into the public bundle at build time. Never
# put a secret here — the Anthropic API key lives only on the backend.
VITE_API_BASE=
